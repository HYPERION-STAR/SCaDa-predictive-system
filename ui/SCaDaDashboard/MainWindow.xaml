<Window x:Class="SCaDaDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:SCaDaDashboard.Controls"
        Title="SCaDa Kestirimci Bakım - Canlı İzleme"
        Height="820" Width="1320"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{DynamicResource BgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== ÜST BAR ==================== -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" Padding="20,14"
                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="SCaDa KESTİRİMCİ BAKIM" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,0,0">
                        <Run Text="Yapay zeka destekli makine sağlığı izleme"/>
                        <Run Text="  •  Veri kaynağı: " Foreground="{DynamicResource AccentBrush}"/><Run Text="{Binding SourceLabel, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Ozet sayaclar -->
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="14,8" Margin="6,0"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="TOPLAM" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock Text="{Binding TotalCount}" FontSize="18" FontWeight="Bold"
                                       Style="{StaticResource NumText}"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="14,8" Margin="6,0"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="SAĞLIKLI" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock Text="{Binding HealthyCount}" FontSize="18" FontWeight="Bold"
                                       Style="{StaticResource NumText}" Foreground="{StaticResource HealthyBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="14,8" Margin="6,0"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="UYARI/RİSK" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock Text="{Binding WarningCount}" FontSize="18" FontWeight="Bold"
                                       Style="{StaticResource NumText}" Foreground="{StaticResource WarnBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="14,8" Margin="6,0"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="KRİTİK" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock Text="{Binding CriticalCount}" FontSize="18" FontWeight="Bold"
                                       Style="{StaticResource NumText}" Foreground="{StaticResource CriticalBrush}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding Clock}" VerticalAlignment="Center" Margin="16,0,0,0"
                               Style="{StaticResource NumText}"
                               FontSize="13" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== GÖVDE ==================== -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="150"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="AlertRow" Height="190" MinHeight="40" MaxHeight="520"/>
            </Grid.RowDefinitions>

            <!-- Makine kartlari -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="14,14,14,14">
                <ItemsControl ItemsSource="{Binding Machines}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Kart: golge + hover'da 2px yukari kalkis -->
                            <Border Width="300" Margin="8" Padding="20"
                                    Background="{DynamicResource CardBrush}" CornerRadius="16"
                                    BorderBrush="{Binding StatusBrush}" BorderThickness="1.5"
                                    Effect="{DynamicResource CardShadow}">
                                <Border.RenderTransform>
                                    <TranslateTransform/>
                                </Border.RenderTransform>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                                             To="-2" Duration="0:0:0.12"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                                             To="0" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <!-- Baslik satiri -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Id}" FontSize="12"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                                <TextBlock Text="{Binding Type, StringFormat=' •  {0}'}" FontSize="12"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                        </StackPanel>
                                        <!-- Durum rozeti: soluk zemin + renkli yazi (hap bicimi) -->
                                        <Border Grid.Column="1" VerticalAlignment="Top"
                                                Background="{Binding StatusBrush, Converter={StaticResource Tint}}"
                                                CornerRadius="10" Padding="10,4">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{Binding StatusBrush}"/>
                                        </Border>
                                    </Grid>

                                    <!-- Saglik cubugu -->
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="SAĞLIK DURUMU" FontSize="11"
                                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Bottom"/>
                                        <TextBlock Grid.Column="1" FontSize="19" FontWeight="Bold"
                                                   Style="{StaticResource NumText}"
                                                   Foreground="{Binding StatusBrush}"
                                                   Text="{Binding HealthScore, Converter={StaticResource Percent}}"/>
                                    </Grid>
                                    <ProgressBar Style="{StaticResource HealthBar}" Margin="0,6,0,0"
                                                 Value="{Binding HealthScore, Mode=OneWay}" Foreground="{Binding StatusBrush}"/>

                                    <!-- RUL + anomali -->
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="KALAN ÖMÜR (RUL)" FontSize="10"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock FontSize="15" Foreground="{DynamicResource TextBrush}"
                                                       Style="{StaticResource NumText}"
                                                       Text="{Binding Rul, StringFormat={}{0:0} döngü}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="ANOMALİ OLASILIĞI" FontSize="10"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock FontSize="15" Foreground="{DynamicResource TextBrush}"
                                                       Style="{StaticResource NumText}"
                                                       Text="{Binding AnomalyProbability, StringFormat={}{0:P0}}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Sensor grafikleri -->
                                    <StackPanel Margin="0,14,0,0">
                                        <!-- Sicaklik -->
                                        <Grid Margin="0,0,0,2">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Fill="{StaticResource TempBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Sıcaklık" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                            </StackPanel>
                                            <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TempBrush}"
                                                       Style="{StaticResource NumText}"
                                                       Text="{Binding Temperature, StringFormat={}{0:0.0} °C}"/>
                                        </Grid>
                                        <c:MiniChart Height="52" Background="{DynamicResource TrackBrush}"
                                                     LineBrush="{StaticResource TempBrush}"
                                                     Values="{Binding TemperatureHistory}"/>

                                        <!-- Basinc -->
                                        <Grid Margin="0,8,0,2">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Fill="{StaticResource PresBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Basınç" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                            </StackPanel>
                                            <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource PresBrush}"
                                                       Style="{StaticResource NumText}"
                                                       Text="{Binding Pressure, StringFormat={}{0:0.00} bar}"/>
                                        </Grid>
                                        <c:MiniChart Height="52" Background="{DynamicResource TrackBrush}"
                                                     LineBrush="{StaticResource PresBrush}"
                                                     Values="{Binding PressureHistory}"/>

                                        <!-- Titresim -->
                                        <Grid Margin="0,8,0,2">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Fill="{StaticResource VibBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Titreşim" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                            </StackPanel>
                                            <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource VibBrush}"
                                                       Style="{StaticResource NumText}"
                                                       Text="{Binding Vibration, StringFormat={}{0:0.00} mm/s}"/>
                                        </Grid>
                                        <c:MiniChart Height="52" Background="{DynamicResource TrackBrush}"
                                                     LineBrush="{StaticResource VibBrush}"
                                                     Values="{Binding VibrationHistory}"/>
                                    </StackPanel>

                                    <!-- Alt: bakim butonu (statik kaynakta gizli) -->
                                    <Button Style="{StaticResource GhostButton}" Margin="0,14,0,0"
                                            Content="Bakım Yap" Command="{Binding MaintainCommand}"
                                            Visibility="{Binding CanMaintain, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Suruklenebilir ayirici (dikey yeniden boyutlandirma) -->
            <GridSplitter Grid.Row="1" x:Name="AlertSplitter" Height="6"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"
                          Background="{DynamicResource StrokeBrush}" Cursor="SizeNS"/>

            <!-- Uyari paneli (alt satir - suruklenebilir + kucultulebilir, maks yukseklik 520) -->
            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="16,10,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="UYARILAR / OLAYLAR" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Risk eşiği aşıldığında e-posta/SMS simüle edilir"
                                       FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="AlertToggle" Style="{StaticResource GhostButton}"
                                Click="ToggleAlerts_Click" Width="34" Height="26" Padding="0"
                                AutomationProperties.AutomationId="AlertToggle"
                                ToolTip="Küçült / genişlet">
                            <TextBlock x:Name="AlertToggleIcon" Text="&#x25BE;" FontSize="13"/>
                        </Button>
                    </Grid>

                    <ScrollViewer x:Name="AlertList" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="12,0,12,12">
                        <ItemsControl ItemsSource="{Binding Alerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Height="52" Margin="0,0,0,8" Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="2"
                                                    Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Time}" FontSize="11"
                                                               Foreground="{DynamicResource MutedBrush}"/>
                                                    <TextBlock Text="{Binding MachineId}" FontSize="11" FontWeight="Bold"
                                                               Margin="8,0,0,0"
                                                               Foreground="{Binding MachineId, Converter={StaticResource MachineIdToBrush}}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Message}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
